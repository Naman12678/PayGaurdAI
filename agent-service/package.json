{
  "name": "agent-service",
  "version": "1.0.0",
  "description": "LangGraph.js checkout agent - no DB credentials, no Razorpay credentials",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --forceExit"
  },
  "dependencies": {
    "@langchain/google-genai": "^2.3.0",
    "@langchain/core": "1.2.9",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "1.4.12",
    "express": "^4.19.2",
    "uuid": "^10.0.0",
    "zod": "^3.25.32",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {},
    "extensionsToTreatAsEsm": [
      ".js"
    ]
  }
}
